PORT=3001

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=gisele_flavia_modas
DB_USER=postgres
DB_PASSWORD=postgres

CORS_ORIGIN=http://127.0.0.1:5500
JWT_SECRET=troque_este_segredo_em_producao
JWT_EXPIRES_IN=8h
CLIENTE_JWT_EXPIRES_IN=30d

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Gisele Flávia Modas
SMTP_FROM_EMAIL=

EMAIL_ENVIO_ATIVO=false
EMAIL_PEDIDO_RECEBIDO_ATIVO=true
EMAIL_PAGAMENTO_APROVADO_ATIVO=true
EMAIL_STATUS_PEDIDO_ATIVO=true
EMAIL_RECUPERACAO_SENHA_ATIVO=true
EMAIL_COMPROVANTE_ATIVO=true

CLIENTE_RESET_SENHA_EXPIRA_MINUTOS=15
CLIENTE_RESET_SENHA_MAX_TENTATIVAS=5

MERCADO_PAGO_ACCESS_TOKEN=
# Use sandbox localmente e production na VM.
MERCADO_PAGO_ENV=sandbox
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_ENABLED=true
APP_PUBLIC_URL=http://localhost:5500
# Produção: APP_PUBLIC_URL=https://giseleflavia.com

# Preparação para integração oficial dos Correios. Não use credenciais reais neste arquivo.
CORREIOS_ENABLED=false
CORREIOS_ENV=homologacao
CORREIOS_API_USER=
CORREIOS_API_ACCESS_CODE=
CORREIOS_CONTRATO=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CNPJ=
CORREIOS_DR=
CORREIOS_CEP_ORIGEM=
CORREIOS_TIMEOUT_MS=8000
CORREIOS_TOKEN_SAFETY_SECONDS=60
CORREIOS_SERVICOS=PAC,SEDEX
